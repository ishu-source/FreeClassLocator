# Copy to .env only if you add your own AI backend. NEVER commit a real .env file.

# URL of YOUR secure backend endpoint (safe to expose: it is only a URL).
# The advisor POSTs { question, context } here and expects { reply } back.
VITE_ADVISOR_ENDPOINT=

# Server-side only. Put this in your backend / hosting dashboard environment variables.
# Never prefix it with VITE_ (Vite would bundle it into public JavaScript).
ADVISOR_API_KEY=

# Round 2, optional. URL of YOUR backend that turns a room request into structured filters.
# POST { query, context } -> { filters: { floor, ac, capacity, durationMinutes, startTime, endTime } }.
# Leave empty to use the built-in offline parser. Any failure falls back to the offline parser.
# Keep provider API keys on that server, never in a VITE_ variable.
VITE_ROOM_AI_ENDPOINT=
